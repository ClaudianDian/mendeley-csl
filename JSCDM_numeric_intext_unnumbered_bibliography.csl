<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="numeric" default-locale="en-US">
  <info>
    <title>JSCDM Numeric In-Text - Unnumbered Bibliography</title>
    <title-short>JSCDM Numeric Unnumbered Bibliography</title-short>
    <id>http://www.zotero.org/styles/jscdm-numeric-intext-unnumbered-bibliography</id>
    <link href="http://www.zotero.org/styles/jscdm-numeric-intext-unnumbered-bibliography" rel="self"/>
    <link href="https://publisher.uthm.edu.my/ojs/index.php/jscdm" rel="documentation"/>
    <author>
      <name>OpenAI custom style for JSCDM</name>
    </author>
    <category citation-format="numeric"/>
    <category field="computer-science"/>
    <summary>JSCDM custom CSL: numeric citations in text, APA-like bibliography without printed reference numbers so Word's built-in Reference paragraph style can supply numbering.</summary>
    <updated>2026-09-18T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This CSL style is licensed under CC BY-SA 3.0.</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter=", "
            delimiter-precedes-last="always"
            and="symbol"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued" prefix="(" suffix=").">
      <date-part name="year"/>
      <date-part name="month" prefix=", " form="long"/>
    </date>
  </macro>

  <macro name="title">
    <choose>
      <if type="book graphic motion_picture song speech thesis manuscript report webpage post post-weblog dataset" match="any">
        <text variable="title" font-style="italic" suffix="."/>
      </if>
      <else>
        <text variable="title" suffix="."/>
      </else>
    </choose>
  </macro>

  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <group delimiter="">
            <text variable="volume" font-style="italic"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>

      <else-if type="paper-conference">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="page"/>
          <text variable="publisher"/>
        </group>
      </else-if>

      <else-if type="chapter">
        <group>
          <text term="in" text-case="capitalize-first" suffix=" "/>
          <names variable="editor" suffix=", ">
            <name initialize-with=". "
                  delimiter=", "
                  delimiter-precedes-last="always"
                  and="symbol"/>
            <label form="short" prefix=" (" suffix=".),"/>
          </names>
          <text variable="container-title" font-style="italic"/>
          <text variable="page" prefix=" (pp. " suffix=")"/>
          <text variable="publisher" prefix=". "/>
        </group>
      </else-if>

      <else-if type="book report thesis dataset webpage post post-weblog manuscript" match="any">
        <group delimiter=". ">
          <text variable="publisher"/>
          <text variable="genre"/>
        </group>
      </else-if>

      <else>
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="volume" font-style="italic"/>
          <text variable="issue" prefix="(" suffix=")"/>
          <text variable="page"/>
          <text variable="publisher"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <!-- Numeric citations in the manuscript body -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- Bibliography stays in citation order but DOES NOT print [1], [2], etc. -->
  <bibliography hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author" suffix="."/>
        <text macro="issued"/>
        <text macro="title"/>
      </group>

      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="container" prefix=" " suffix="."/>
        </if>

        <else-if type="paper-conference">
          <group prefix=" " suffix=".">
            <text term="in" text-case="capitalize-first" suffix=" "/>
            <text macro="container"/>
          </group>
        </else-if>

        <else>
          <text macro="container" prefix=" " suffix="."/>
        </else>
      </choose>

      <text macro="access" prefix=" "/>
    </layout>
  </bibliography>
</style>
